    {
      "parameters": {
        "toolDescription": "Retrieves solar potential data for a building. IMPORTANT: Use the exact lat and lng values from the Geocoding API response (geometry.location.lat and geometry.location.lng). Example: if Geocoding returned lat: 50.3032091, lng: 19.5464815, pass these exact numbers.",
        "url": "https://solar.googleapis.com/v1/buildingInsights:findClosest",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "location.latitude",
              "value": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('latitude', 'Exact latitude number from Geocoding API result (geometry.location.lat), e.g. 50.3032091') }}"
            },
            {
              "name": "location.longitude",
              "value": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('longitude', 'Exact longitude number from Geocoding API result (geometry.location.lng), e.g. 19.5464815') }}"
            },
            {
              "name": "key",
              "value": "YOUR_GOOGLE_MAPS_API_KEY"
            }
          ]
        },
        "options": {},
        "optimizeResponse": true,
        "fieldsToInclude": "selected",
        "fields": "solarPotential.maxArrayPanelsCount,solarPotential.maxArrayAreaMeters2,solarPotential.maxSunshineHoursPerYear,solarPotential.carbonOffsetFactorKgPerMwh,solarPotential.panelCapacityWatts,solarPotential.panelLifetimeYears"
      },
