    {
      "parameters": {
        "jsCode": "const d = $('Przygotuj Dane Zaproszenia').first().json;\nconst firestoreBody = JSON.stringify({ fields: {\n  invitationId: { stringValue: d.invitationId },\n  email: { stringValue: d.studentEmail },\n  classId: { stringValue: d.classId },\n  code: { stringValue: d.code },\n  status: { stringValue: 'pending' },\n  emailStatus: { stringValue: 'sending' },\n  sendAttempts: { integerValue: '0' },\n  createdAt: { stringValue: d.createdAt },\n  updatedAt: { stringValue: new Date().toISOString() }\n}});\nreturn [{ json: { ...d, firestoreBody } }];"
      },
