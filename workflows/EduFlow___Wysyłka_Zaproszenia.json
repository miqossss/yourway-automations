    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst studentEmail = String(body.studentEmail || body.email || '').trim().toLowerCase();\nif (!studentEmail) {\n  return [{ json: { error: true, reason: 'Brak adresu email ucznia' } }];\n}\n// Uzyj invitationId i code z Firestore jesli przysly z frontendu\n// Jesli nie - wygeneruj (fallback)\nconst invitationId = body.invitationId || ('inv_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7));\nconst code = body.code || String(Math.floor(100000 + Math.random() * 900000));\nconst now = new Date().toISOString();\nreturn [{ json: {\n  invitationId,\n  studentEmail,\n  classId: body.classId || '',\n  teacherName: body.teacherName || 'Nauczyciel',\n  className: body.className || '',\n  code,\n  createdAt: now,\n  error: false\n}}];"
      },
