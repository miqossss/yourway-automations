    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst output = item.rawOutput || item.output;\nconst match = output.match(/LEAD_COLLECTED\\|(.+?)\\|(.+?)\\|(.+?)\\|(.+?)\\|(.+?)\\|(.+)/);\n\nif (match) {\n  return [{\n    json: {\n      timestamp: new Date().toISOString(),\n      'Imie i nazwisko': match[1].trim(),\n      'Email': match[2].trim(),\n      'Telefon': match[3].trim(),\n      'Wiek': match[4].trim(),\n      'Cel treningowy': match[5].trim(),\n      'Forma wspolpracy': match[6].trim()\n    }\n  }];\n}\n\nreturn [];"
      },
