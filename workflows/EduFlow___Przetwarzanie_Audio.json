      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst binaryData = $input.first().binary;\nconst audioUrl = String(body.audioUrl || '').trim();\nconst hasBinary = !!(binaryData && (binaryData.data || binaryData.file || binaryData.audio));\nconst hasUrl = !!(audioUrl && audioUrl.startsWith('http'));\n\nif (!hasBinary && !hasUrl) {\n  return [{ json: {\n    audioError: true,\n    reason: 'Brak pliku audio — wyslij binary (pole data/audio/file) lub audioUrl'\n  }}];\n}\n\nreturn [{ json: {\n  audioError: false,\n  audioUrl: hasUrl ? audioUrl : '',\n  hasBinary,\n  hasUrl,\n  teacherId: body.teacherId || '',\n  classId: body.classId || '',\n  subject: body.classSubject || body.subject || '',\n  timestamp: body.timestamp || new Date().toISOString()\n}, binary: binaryData }];"
