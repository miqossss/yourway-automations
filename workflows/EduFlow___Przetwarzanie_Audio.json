      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet rawText = '';\nif (item.output && Array.isArray(item.output) && item.output[0] && item.output[0].content) {\n  const ct = item.output[0].content[0] && item.output[0].content[0].text;\n  rawText = (typeof ct === 'object' && ct !== null) ? JSON.stringify(ct) : String(ct || '');\n}\nif (!rawText && typeof item.output === 'string') { rawText = item.output; }\nif (!rawText && item.text) { rawText = String(item.text); }\nrawText = rawText.trim();\nconst tick3 = String.fromCharCode(96,96,96);\nif (rawText.startsWith(tick3)) { const nl = rawText.indexOf(10); rawText = rawText.slice(nl+1); const lt = rawText.lastIndexOf(tick3); if (lt !== -1) rawText = rawText.slice(0, lt); rawText = rawText.trim(); }\nlet parsed = null;\ntry { parsed = JSON.parse(rawText); } catch(e) {}\nif (!parsed) { const s = rawText.indexOf('{'); const e2 = rawText.lastIndexOf('}'); if (s !== -1 && e2 !== -1) { try { parsed = JSON.parse(rawText.substring(s, e2+1)); } catch(e) {} } }\nconst exercises = (parsed && parsed.exercises) ? parsed.exercises : { flashcards: [], quickCheck: [], openTasks: [] };\nconst lessonData = $('Parsuj Quiz i Polacz').first().json;\nconst toFSArr = function(arr) { return { arrayValue: { values: arr.map(function(o) { return { stringValue: JSON.stringify(o) }; }) } }; };\nconst firestoreBody = JSON.stringify({ fields: { flashcards: toFSArr(exercises.flashcards || []), quickCheck: toFSArr(exercises.quickCheck || []), openTasks: toFSArr(exercises.openTasks || []) } });\nreturn [{ json: { lessonId: lessonData.lessonId, classId: lessonData.classId, exercises, firestoreExercisesBody: firestoreBody, teacherId: lessonData.teacherId, subject: lessonData.subject, quiz: lessonData.quiz, _debug: lessonData._debug } }];"
