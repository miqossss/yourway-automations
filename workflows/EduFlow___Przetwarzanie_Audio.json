      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet text = '';\nif (item.text) { text = String(item.text).trim(); }\nif (!text && item.transcription) { text = String(item.transcription).trim(); }\nif (!text && item.transcript) { text = String(item.transcript).trim(); }\n\nconst markers = ['KONIEC', 'KONIEC!', 'END', 'DONE', 'STOP', '[BLANK_AUDIO]', '[CISZA]'];\nconst textUpper = text.toUpperCase().trim();\nconst isMarker = markers.some(function(m) { return textUpper === m || textUpper === m + '.' || textUpper === m + '!'; });\n\nif (!text || text.length < 3 || isMarker) {\n  return [{ json: {\n    success: false,\n    transcriptValid: false,\n    error: 'stt_failed',\n    message: 'Nie udalo sie wygenerowac transkrypcji. Sprawdz czy nagranie zawiera mowe i sprobuj ponownie.'\n  }}];\n}\n\nreturn [{ json: {\n  success: true,\n  transcriptValid: true,\n  transcript: text,\n  transcription: text,\n  transcriptText: text,\n  text: text\n}}];"
      },
