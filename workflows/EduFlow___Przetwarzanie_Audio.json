    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet rawText = '';\nif (item.output && Array.isArray(item.output) && item.output[0] && item.output[0].content) {\n  const ct = item.output[0].content[0] && item.output[0].content[0].text;\n  rawText = (typeof ct === 'object' && ct !== null) ? JSON.stringify(ct) : String(ct || '');\n}\nif (!rawText && typeof item.output === 'string') { rawText = item.output; }\nif (!rawText && item.text) { rawText = String(item.text); }\nif (!rawText && item.message && item.message.content) { rawText = String(item.message.content); }\nrawText = rawText.trim();\nconst tick3 = String.fromCharCode(96,96,96);\nif (rawText.startsWith(tick3)) {\n  const nl = rawText.indexOf(10); rawText = rawText.slice(nl + 1);\n  const lt = rawText.lastIndexOf(tick3); if (lt !== -1) rawText = rawText.slice(0, lt);\n  rawText = rawText.trim();\n}\nlet parsed = null;\ntry { parsed = JSON.parse(rawText); } catch(e) {}\nif (!parsed) {\n  const s = rawText.indexOf('{'), e2 = rawText.lastIndexOf('}');\n  if (s !== -1 && e2 !== -1) { try { parsed = JSON.parse(rawText.substring(s, e2+1)); } catch(e) {} }\n}\nif (!parsed) { parsed = { title: 'Lekcja', note: '' }; }\nconst note = String(parsed.note || '').trim();\nconst title = String(parsed.title || 'Lekcja').trim();\nif (!note || note.length < 40) { return [{ json: { noteError: true, reason: 'Brak wygenerowanej notatki', noteLength: note.length } }]; }\nconst meta = $('Normalizuj Dane (approve)').first().json;\nconst lessonId = 'lesson_' + Date.now();\nreturn [{ json: { lessonId, teacherId: meta.teacherId, classId: meta.classId, subject: meta.subject || '', className: meta.className || '', timestamp: meta.timestamp, title, note, transcript: meta.transcript, noteError: false, noteLength: note.length } }];"
      },
