    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet rawText = '';\nif (item.output && Array.isArray(item.output) && item.output[0] && item.output[0].content) {\n  const ct = item.output[0].content[0] && item.output[0].content[0].text;\n  rawText = (typeof ct === 'object' && ct !== null) ? JSON.stringify(ct) : String(ct || '');\n}\nif (!rawText && typeof item.output === 'string') { rawText = item.output; }\nif (!rawText && item.text) { rawText = String(item.text); }\nrawText = rawText.trim();\nconst tick3 = String.fromCharCode(96,96,96);\nif (rawText.startsWith(tick3)) {\n  const nl = rawText.indexOf(10); rawText = rawText.slice(nl + 1);\n  const lt = rawText.lastIndexOf(tick3); if (lt !== -1) rawText = rawText.slice(0, lt);\n  rawText = rawText.trim();\n}\nlet parsed = null;\ntry { parsed = JSON.parse(rawText); } catch(e) {}\nif (!parsed) {\n  const s = rawText.indexOf('{'); const e2 = rawText.lastIndexOf('}');\n  if (s !== -1 && e2 !== -1) { try { parsed = JSON.parse(rawText.substring(s, e2+1)); } catch(e) {} }\n}\nif (!parsed) { parsed = {}; }\nlet quiz = [];\nif (Array.isArray(parsed.questions)) { quiz = parsed.questions.filter(function(q) { return typeof q === 'string' && q.trim(); }); }\nelse if (Array.isArray(parsed.quiz)) { quiz = parsed.quiz.filter(function(q) { return typeof q === 'string' && q.trim(); }); }\nconst seen = {};\nquiz = quiz.filter(function(q) { const k = q.toLowerCase().trim(); if (seen[k]) return false; seen[k] = true; return true; });\nif (quiz.length > 8) { quiz = quiz.slice(0, 8); }\nconst noteData = $('Parsuj Notatke').first().json;\nif (quiz.length < 6) { return [{ json: { validationError: true, reason: 'Za malo pytan w quizie (min 6, otrzymano ' + quiz.length + ')' } }]; }\nreturn [{ json: { lessonId: noteData.lessonId, teacherId: noteData.teacherId, classId: noteData.classId, subject: noteData.subject, className: noteData.className, timestamp: noteData.timestamp, title: noteData.title, note: noteData.note, quiz, transcript: noteData.transcript, validationError: false, _debug: { noteLength: noteData.noteLength, quizCount: quiz.length, subjectResolved: noteData.subject || 'brak' } } }];"
